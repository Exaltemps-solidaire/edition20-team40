# Variables lues par l'application. Copier en .env pour un usage local (non commité).

# api/ — port d'écoute du service API. 8081 est le port publié par la plateforme de déploiement.
PORT=8081

# frontend/ — site statique servi par nginx sur le port 80 (interne au conteneur, publié en 8080
# par la plateforme). Aucune variable d'environnement n'est encore lue côté frontend.
